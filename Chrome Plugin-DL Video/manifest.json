{
  "manifest_version": 3,
  "name": "Veloce Video Downloader",
  "version": "1.0",
  "description": "Download embedded videos on any webpage with a custom location prompt.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "declarativeNetRequest"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
